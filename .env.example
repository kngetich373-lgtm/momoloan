NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_PHONES=+254700000000
OTP_MODE=console
# Telegram admin bot (optional). Without these, bot commands/notifications are disabled.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Comma-separated allowlist of Telegram user IDs permitted to use the admin bot.
# TELEGRAM_ADMIN_CHAT_ID=123456789
# Production SMS integration: implement src/sms.js with a reputable provider.
# Never ask users for their mobile-money PIN or a transaction OTP.
